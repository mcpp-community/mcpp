// A build program written the way most are: narrow getenv, a narrow path
// into std::ofstream, the path printed back to mcpp as bytes.
#include <cstdio>
#include <cstdlib>
#include <fstream>
#include <string>

int main() {
    const char* out = std::getenv("MCPP_OUT_DIR");
    if (!out) { std::fputs("no MCPP_OUT_DIR\n", stderr); return 1; }
    std::string p = std::string(out) + "/gen.cpp";
    std::ofstream f(p);
    if (!f) { std::fprintf(stderr, "build.mcpp: cannot open %s\n", p.c_str()); return 2; }
    f << "int gen_value() { return 42; }\n";
    f.close();
    std::printf("mcpp:generated=%s\n", p.c_str());
    return 0;
}
