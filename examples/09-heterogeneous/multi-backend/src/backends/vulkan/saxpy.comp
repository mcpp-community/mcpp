#version 450

// The device side of the same computation the `cuda` example runs on
// CUDA: out = a*x + y. One storage buffer holds all three vectors so the host
// side needs one allocation and one descriptor.
layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Data { float v[]; };
layout(push_constant) uniform Push { float a; uint n; } push;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= push.n) return;
    v[2u * push.n + i] = push.a * v[i] + v[push.n + i];
}
