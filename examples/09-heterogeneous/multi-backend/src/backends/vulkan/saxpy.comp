#version 450
// The Vulkan island: a compute shader, compiled to SPIR-V by mcpp.rules.spirv.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly  buffer X { float x[]; };
layout(std430, binding = 1) readonly  buffer Y { float y[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(push_constant) uniform P { float a; uint n; } p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < p.n) o[i] = p.a * x[i] + y[i];
}
